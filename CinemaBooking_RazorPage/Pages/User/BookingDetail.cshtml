@page
@model CinemaBooking_RazorPage.Pages.User.BookingDetailModel
@{
}

<!DOCTYPE html>

<html class="dark" lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>CinemaVN - Ticket Detail</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&amp;family=Manrope:wght@300;400;500;600;700;800&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary-fixed": "#ffdcc3",
                        "surface-variant": "#353534",
                        "on-primary-fixed": "#2f1500",
                        "secondary-fixed-dim": "#fdb881",
                        "surface-container-low": "#1c1b1b",
                        "on-secondary-fixed-variant": "#6a3b0f",
                        "surface-dim": "#131313",
                        "surface-container-highest": "#353534",
                        "on-primary-container": "#623200",
                        "primary": "#ffb77d",
                        "on-secondary-container": "#e9a771",
                        "on-error-container": "#ffdad6",
                        "on-primary": "#4d2600",
                        "surface": "#131313",
                        "primary-fixed-dim": "#ffb77d",
                        "surface-container-high": "#2a2a2a",
                        "error": "#ffb4ab",
                        "on-tertiary-container": "#004360",
                        "outline-variant": "#564334",
                        "on-surface": "#e5e2e1",
                        "on-secondary-fixed": "#2f1500",
                        "on-background": "#e5e2e1",
                        "inverse-primary": "#904d00",
                        "tertiary-container": "#00b5fc",
                        "error-container": "#93000a",
                        "tertiary-fixed-dim": "#85cfff",
                        "surface-bright": "#393939",
                        "on-surface-variant": "#ddc1ae",
                        "primary-container": "#ff8c00",
                        "outline": "#a48c7a",
                        "surface-container-lowest": "#0e0e0e",
                        "on-tertiary": "#00344c",
                        "on-primary-fixed-variant": "#6e3900",
                        "tertiary": "#85cfff",
                        "tertiary-fixed": "#c7e7ff",
                        "on-tertiary-fixed-variant": "#004c6c",
                        "surface-container": "#201f1f",
                        "inverse-surface": "#e5e2e1",
                        "on-tertiary-fixed": "#001e2e",
                        "secondary-container": "#6a3b0f",
                        "secondary": "#fdb881",
                        "surface-tint": "#ffb77d",
                        "on-secondary": "#4d2600",
                        "background": "#131313",
                        "on-error": "#690005",
                        "inverse-on-surface": "#313030",
                        "secondary-fixed": "#ffdcc3"
                    },
                    fontFamily: {
                        "headline": ["Space Grotesk"],
                        "body": ["Manrope"],
                        "label": ["Manrope"]
                    },
                    borderRadius: {"DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem"},
                },
            },
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        .glass-panel {
            background: rgba(19, 19, 19, 0.7);
            backdrop-filter: blur(20px);
        }

        .spotlight-gradient {
            background: linear-gradient(135deg, #ffb77d 0%, #ff8c00 100%) !important;
        }

        .text-spotlight {
            color: #ff8c00 !important;
        }

        .bg-spotlight {
            background-color: #ff8c00 !important;
        }
    </style>
</head>
<body class="bg-surface text-on-surface font-body selection:bg-primary/30">
    <!-- TopAppBar -->
    <header class="fixed top-0 w-full z-50 bg-[#131313]/70 backdrop-blur-xl bg-gradient-to-b from-[#131313] to-transparent shadow-[0_40px_40px_-15px_rgba(255,183,125,0.06)] flex justify-between items-center px-6 py-4 w-full">
        <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-spotlight text-3xl" style="font-variation-settings: 'FILL' 1;">movie</span>
            <span class="text-[#ffb77d] font-space-grotesk italic tracking-tighter text-2xl font-bold">CinemaVN</span>
        </div>
    </header>
    <main class="pt-28 pb-32 px-4 md:px-8 max-w-6xl mx-auto min-h-screen">
        <!-- Breadcrumb / Back Action -->
        <a asp-page="/User/BookingHistory"
           class="mb-8 flex items-center gap-2 text-on-surface-variant cursor-pointer hover:text-primary transition-colors">

            <span class="material-symbols-outlined text-sm">arrow_back_ios</span>
            <span class="font-label text-xs uppercase tracking-[0.2em]">
                Quay lại lịch sử đặt vé
            </span>
        </a>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            <!-- Left Column: Poster -->
            <div class="lg:col-span-5 relative group">
                <div class="absolute -inset-4 bg-primary/5 rounded-full blur-3xl opacity-50 group-hover:opacity-100 transition-opacity"></div>

                <div class="relative aspect-[2/3] overflow-hidden rounded-xl shadow-[0_20px_50px_rgba(0,0,0,0.5)] border border-outline-variant/10">
                    <img class="w-full h-full object-cover transform transition-transform duration-700 group-hover:scale-105"
                         src="@($"http://localhost:5237{Model.Booking.PosterUrl}")"
                         alt="@Model.Booking.MovieName" />

                    <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest via-transparent to-transparent"></div>

                    <div class="absolute bottom-6 left-6 right-6">
                        <h1 class="font-headline text-4xl font-bold tracking-tighter text-on-surface leading-none uppercase">
                            @Model.Booking.MovieName
                        </h1>
                    </div>
                </div>
            </div>

            <!-- Right Column -->
            <div class="lg:col-span-7 space-y-6">
                <!-- Booking Date -->
                <div class="bg-surface-container p-6 rounded-xl border-l-2 border-primary/20">
                    <div class="flex items-center gap-4 mb-4">
                        <span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 1;">
                            event
                        </span>
                        <p class="font-label text-[10px] uppercase tracking-[0.2em] text-on-surface-variant">
                            Ngày đặt vé
                        </p>
                    </div>

                    <p class="font-headline text-lg font-semibold text-on-surface">
                        @TimeZoneInfo.ConvertTimeFromUtc(
                        Model.Booking.BookingDate,
                                                TimeZoneInfo.FindSystemTimeZoneById("SE Asia Standard Time")
                                                ).ToString("HH:mm dd/MM/yyyy")
                    </p>
                </div>
                <!-- Transaction -->
                <div class="bg-surface-container-low p-8 rounded-xl relative overflow-hidden">
                    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 relative z-10">
                        <div>
                            <p class="font-label text-[10px] uppercase tracking-[0.3em] text-on-surface-variant mb-1">
                                Mã giao dịch
                            </p>
                            <h2 class="font-headline text-2xl font-bold tracking-widest text-primary">
                                @Model.Booking.TransactionContent
                            </h2>
                        </div>

                        @{
                            var status = Model.Booking.Status;
                            var color = status == "Paid" ? "green" :
                            status == "Pending" ? "yellow" : "red";
                        }

                        <div class="flex items-center gap-3 bg-@color-500/10 border border-@color-500/20 px-6 py-3 rounded-full">
                            <span class="flex h-2 w-2 rounded-full bg-@color-500 animate-pulse"></span>
                            <span class="font-label text-sm font-extrabold text-@color-500 tracking-widest">
                                @status.ToUpper()
                            </span>
                        </div>
                    </div>

                    <div class="absolute -right-4 -top-8 font-headline text-9xl font-black text-white/5 pointer-events-none italic">
                        #@Model.Booking.Id
                    </div>
                </div>

                <!-- Grid info -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

                    <!-- Theater -->
                    <div class="bg-surface-container p-6 rounded-xl border-l-2 border-primary/20">
                        <div class="flex items-center gap-4 mb-4">
                            <span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 1;">
                                theater_comedy
                            </span>
                            <p class="font-label text-[10px] uppercase tracking-[0.2em] text-on-surface-variant">
                                Rạp &amp; Phòng chiếu
                            </p>
                        </div>
                        <p class="font-headline text-lg font-semibold text-on-surface">
                            @Model.Booking.TheaterName
                        </p>
                        <p class="font-body text-sm text-on-surface-variant">
                            @Model.Booking.RoomName
                        </p>
                    </div>

                    <!-- Time -->
                    <div class="bg-surface-container p-6 rounded-xl border-l-2 border-primary/20">
                        <div class="flex items-center gap-4 mb-4">
                            <span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 1;">
                                schedule
                            </span>
                            <p class="font-label text-[10px] uppercase tracking-[0.2em] text-on-surface-variant">
                                Thời gian xuất chiếu
                            </p>
                        </div>

                        <p class="font-headline text-lg font-semibold text-on-surface">
                            @Model.Booking.StartTime.ToString("HH:mm") - @Model.Booking.EndTime.ToString("HH:mm")
                        </p>
                        <p class="font-body text-sm text-on-surface-variant">
                            @Model.Booking.StartTime.ToString("dddd, dd/MM/yyyy")
                        </p>
                    </div>

                    <!-- Seats -->
                    <div class="bg-surface-container p-6 rounded-xl border-l-2 border-primary/20">
                        <div class="flex items-center gap-4 mb-4">
                            <span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 1;">
                                chair
                            </span>
                            <p class="font-label text-[10px] uppercase tracking-[0.2em] text-on-surface-variant">
                                Vị trí ghế ngồi
                            </p>
                        </div>

                        <div class="flex gap-2 flex-wrap">
                            @foreach (var seat in Model.Booking.Seats)
                            {
                                <span class="bg-surface-container-highest px-3 py-1 rounded text-primary font-headline font-bold">
                                    Ghế @seat.SeatId
                                </span>
                            }
                        </div>
                    </div>

                    <!-- Price -->
                    <div class="bg-surface-container p-6 rounded-xl border-l-2 border-primary/20">
                        <div class="flex items-center gap-4 mb-4">
                            <span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 1;">
                                payments
                            </span>
                            <p class="font-label text-[10px] uppercase tracking-[0.2em] text-on-surface-variant">
                                Tổng thanh toán
                            </p>
                        </div>

                        <p class="font-headline text-2xl font-extrabold text-on-surface">
                            @Model.Booking.TotalPrice.ToString("N0")
                            <span class="text-xs ml-1 font-normal opacity-60">VNĐ</span>
                        </p>

                        <p class="font-body text-[10px] uppercase tracking-tighter
                            @(Model.Booking.Status == "Paid" ? "text-green-500" :
                                 Model.Booking.Status == "Pending" ? "text-yellow-500" :
                                 "text-red-500")">

                            @(Model.Booking.Status == "Paid" ? "Giao dịch đã hoàn tất" :
                                                     Model.Booking.Status == "Pending" ? "Chờ thanh toán" :
                                                     "Đã hủy")
                        </p>
                    </div>
                </div>

                <!-- Message (compact) -->
                <div class="flex items-center gap-3 bg-primary/10 border border-primary/20 px-4 py-3 rounded-lg">
                    <span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 1;">
                        info
                    </span>
                    <p class="text-sm text-on-surface">
                        Vui lòng xuất trình vé này tại quầy khi đến rạp.
                    </p>
                </div>
            </div>
        </div>
    </main>
    <!-- BottomNavBar (Mobile Only) -->
    <nav class="md:hidden fixed bottom-0 left-0 w-full flex justify-around items-center px-6 pb-8 pt-4 bg-[#131313]/70 backdrop-blur-xl rounded-t-3xl z-50 shadow-[0_-10px_30px_rgba(0,0,0,0.5)]">
        <div class="flex flex-col items-center justify-center text-[#564334] hover:text-[#ffb77d] transition-all active:scale-95 duration-200">
            <span class="material-symbols-outlined">movie</span>
            <span class="font-manrope text-[10px] font-medium uppercase tracking-widest mt-1">Premiere</span>
        </div>
        <div class="flex flex-col items-center justify-center text-[#564334] hover:text-[#ffb77d] transition-all active:scale-95 duration-200">
            <span class="material-symbols-outlined">theater_comedy</span>
            <span class="font-manrope text-[10px] font-medium uppercase tracking-widest mt-1">Cinemas</span>
        </div>
        <div class="flex flex-col items-center justify-center text-[#ffb77d] after:content-[''] after:w-1 after:h-1 after:bg-spotlight after:rounded-full after:mt-1 active:scale-95 duration-200">
            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">confirmation_number</span>
            <span class="font-manrope text-[10px] font-medium uppercase tracking-widest mt-1">Tickets</span>
        </div>
        <div class="flex flex-col items-center justify-center text-[#564334] hover:text-[#ffb77d] transition-all active:scale-95 duration-200">
            <span class="material-symbols-outlined">person</span>
            <span class="font-manrope text-[10px] font-medium uppercase tracking-widest mt-1">Profile</span>
        </div>
    </nav>
    <!-- Footer -->
    <footer class="bg-surface-container-lowest py-16 px-6 md:px-20 border-t border-outline-variant/5">
        <div class="max-w-6xl mx-auto flex flex-col md:flex-row justify-between items-start gap-12">
            <div class="space-y-6 max-w-sm">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-spotlight text-3xl" style="font-variation-settings: 'FILL' 1;">movie</span>
                    <span class="text-[#ffb77d] font-space-grotesk italic tracking-tighter text-3xl font-bold">CinemaVN</span>
                </div>
                <p class="text-on-surface-variant text-sm leading-relaxed font-body">Mang trải nghiệm điện ảnh thượng lưu đến gần bạn hơn. Tận hưởng từng khoảnh khắc nghệ thuật trong không gian Noir Premiere sang trọng.</p>
            </div>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-12 w-full md:w-auto">
                <div class="space-y-4">
                    <h4 class="font-headline text-xs font-bold uppercase tracking-[0.2em] text-primary">Dịch vụ</h4>
                    <ul class="space-y-2 text-sm text-on-surface-variant font-body">
                        <li class="hover:text-on-surface cursor-pointer">Lịch chiếu</li>
                        <li class="hover:text-on-surface cursor-pointer">Rạp đang mở</li>
                        <li class="hover:text-on-surface cursor-pointer">Phim sắp chiếu</li>
                    </ul>
                </div>
                <div class="space-y-4">
                    <h4 class="font-headline text-xs font-bold uppercase tracking-[0.2em] text-primary">Hỗ trợ</h4>
                    <ul class="space-y-2 text-sm text-on-surface-variant font-body">
                        <li class="hover:text-on-surface cursor-pointer">Liên hệ</li>
                        <li class="hover:text-on-surface cursor-pointer">Câu hỏi thường gặp</li>
                        <li class="hover:text-on-surface cursor-pointer">Chính sách bảo mật</li>
                    </ul>
                </div>
                <div class="space-y-4 hidden md:block">
                    <h4 class="font-headline text-xs font-bold uppercase tracking-[0.2em] text-primary">Địa chỉ</h4>
                    <p class="text-sm text-on-surface-variant leading-relaxed font-body">Thanh Hóa</p>
                </div>
            </div>
        </div>
    </footer>
</body>
</html>