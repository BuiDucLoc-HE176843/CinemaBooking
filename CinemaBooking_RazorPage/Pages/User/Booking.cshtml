@page
@model CinemaBooking_RazorPage.Pages.User.BookingModel
@{
}

<!DOCTYPE html>

<html class="dark" lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@100;200;300;400;500;600;700;800;900&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#ff8c00",
                        "background-light": "#f8f7f5",
                        "background-dark": "#0a0a0a",
                        "neutral-800": "#1a1a1a",
                        "neutral-700": "#2d2d2d",
                        "accent-cyan": "#00f2ff",
                    },
                    fontFamily: {
                        "display": ["Be Vietnam Pro", "sans-serif"]
                    },
                    borderRadius: {
                        "DEFAULT": "9999px",
                        "lg": "9999px",
                        "xl": "9999px",
                        "full": "9999px"
                    },
                },
            },
        }
    </script>
    <style>
        :root {
            --primary-orange: #ff8c00 !important;
            --primary-glow: rgba(255, 140, 0, 0.4) !important;
            --cyan-glow: rgba(0, 242, 255, 0.5) !important;
        }

        .seat-selected {
            background-color: var(--primary-orange) !important;
            box-shadow: 0 0 15px var(--primary-glow) !important;
            border-color: var(--primary-orange) !important;
        }

        .seat-pending {
            background-color: #00f2ff !important;
            box-shadow: 0 0 15px var(--cyan-glow) !important;
            border-color: #00f2ff !important;
        }

        .screen-curve {
            perspective: 1000px;
        }

        .screen-element {
            height: 8px;
            width: 80%;
            background: linear-gradient(to bottom, #ffffff, transparent);
            box-shadow: 0 10px 30px rgba(255,255,255,0.2);
            border-radius: 50% / 100% 100% 0 0;
            transform: rotateX(-45deg);
        }
        /* Custom date input styling */
        input[type="date"]::-webkit-calendar-picker-indicator {
            filter: invert(1);
            cursor: pointer;
        }
        /* Ensure primary orange persists */
        .bg-primary {
            background-color: #ff8c00 !important;
        }

        .text-primary {
            color: #ff8c00 !important;
        }

        .border-primary {
            border-color: #ff8c00 !important;
        }
    </style>
</head>
<body class="bg-background-light dark:bg-background-dark font-display text-slate-900 dark:text-slate-100 min-h-screen">
    <div class="layout-container flex flex-col min-h-screen">
        <!-- Header Section -->
        <header class="w-full border-b border-neutral-800 bg-neutral-900/50 backdrop-blur-md sticky top-0 z-50">
            <div class="max-w-[1440px] mx-auto px-6 h-20 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <div class="size-10 bg-primary rounded-xl flex items-center justify-center shadow-lg shadow-primary/20">
                        <span class="material-symbols-outlined text-white text-2xl">movie</span>
                    </div>
                    <span class="text-xl font-black tracking-tighter text-white">Cinema<span class="text-primary">VN</span></span>
                </div>
                <h1 class="absolute left-1/2 -translate-x-1/2 text-lg font-bold uppercase tracking-[0.2em] text-neutral-200">Trang đặt vé</h1>
                <div class="w-10 md:w-32"></div> <!-- Spacer to maintain centering -->
            </div>
        </header>
        <main class="flex-grow max-w-[1440px] mx-auto w-full p-6 grid grid-cols-1 lg:grid-cols-12 gap-8">
            <!-- Left Column: Movie Info & Controls -->
            <aside class="lg:col-span-3 flex flex-col gap-6">
                <div class="bg-neutral-800 rounded-3xl overflow-hidden border border-neutral-700">
                    <div class="aspect-[2/3] w-full bg-neutral-700 relative">
                        <img class="w-full h-full object-cover"
                             src="@(Model.Movie?.PosterUrl != null ? "http://localhost:5237" + Model.Movie.PosterUrl : "/images/no-image.png")"
                             alt="@Model.Movie?.Title" />

                        @if (Model.Movie?.IsMainFeature == true)
                        {
                            <div class="absolute top-4 left-4 px-3 py-1 bg-primary text-white text-[10px] font-bold rounded-full uppercase">
                                Hot
                            </div>
                        }
                    </div>
                    <div class="p-6">
                        <h2 class="text-xl font-bold leading-tight mb-2 text-white">@Model.Movie?.Title</h2>
                        <div class="flex items-center gap-4 text-sm text-neutral-400 mb-6">
                            <span>@Model.Movie?.DurationMinutes phút</span>
                        </div>
                        <div class="space-y-6">
                            <form method="get">
                                <input type="hidden" name="Id" value="@Model.Id" />
                                <div class="space-y-6">
                                    <!-- Chọn rạp -->
                                    <div>
                                        <label class="text-[10px] font-bold text-neutral-500 uppercase block mb-2 px-1">
                                            Chọn Rạp
                                        </label>
                                        <select name="TheaterId"
                                                class="w-full bg-neutral-900 border border-neutral-700 rounded-full text-white text-sm p-3">
                                            <option value="">-- Tất cả rạp --</option>
                                            @foreach (var theater in Model.Theaters)
                                            {
                                                <option value="@theater.Id"
                                                        selected="@(Model.TheaterId == theater.Id)">
                                                    @theater.Name
                                                </option>
                                            }
                                        </select>
                                    </div>

                                    <!-- Ngày chiếu -->
                                    <div>
                                        <label class="text-[10px] font-bold text-neutral-500 uppercase block mb-2 px-1">
                                            Ngày Chiếu Từ
                                        </label>
                                        <input type="date"
                                               name="StartTime"
                                               value="@Model.StartTime?.ToString("yyyy-MM-dd")"
                                               class="w-full bg-neutral-900 border-neutral-700 rounded-full text-white text-sm focus:ring-primary focus:border-primary p-3" />
                                    </div>

                                    <div>
                                        <label class="text-[10px] font-bold text-neutral-500 uppercase block mb-2 px-1">
                                            Ngày Chiếu Đến
                                        </label>
                                        <input type="date"
                                               name="EndTime"
                                               value="@Model.EndTime?.ToString("yyyy-MM-dd")"
                                               class="w-full bg-neutral-900 border-neutral-700 rounded-full text-white text-sm focus:ring-primary focus:border-primary p-3" />
                                    </div>

                                    <!-- Nút tìm -->
                                    <button type="submit"
                                            class="w-full bg-primary text-white rounded-full py-3 text-sm font-bold hover:opacity-90 transition">
                                        Tìm suất chiếu
                                    </button>

                                    <!-- Showtime -->
                                    <div>
                                        <div>
                                            <label class="text-[10px] font-bold text-neutral-500 uppercase block mb-2 px-1">
                                                Phòng Chiếu & Suất chiếu
                                            </label>
                                            <div class="space-y-3">
                                                @if (Model.Showtimes != null && Model.Showtimes.Any())
                                                {
                                                    var rooms = Model.Showtimes
                                                    .GroupBy(x => new { x.RoomId, x.RoomName });
                                                    foreach (var room in rooms)
                                                    {
                                                        <div class="bg-neutral-900/50 rounded-2xl p-3 border border-neutral-700">

                                                            <!-- ROOM NAME -->
                                                            <div class="text-sm font-extrabold text-white bg-primary px-3 py-1 rounded-md inline-block mb-3 uppercase tracking-wide shadow">
                                                                @room.Key.RoomName
                                                            </div>
                                                            <!-- SHOWTIME LIST (HORIZONTAL) -->
                                                            <div class="flex gap-3 overflow-x-auto pb-2">
                                                                @foreach (var show in room)
                                                                {
                                                                    <a asp-page="./Booking"
                                                                       asp-route-id="@Model.Id"
                                                                       asp-route-theaterId="@Model.TheaterId"
                                                                       asp-route-startTime="@Model.StartTime"
                                                                       asp-route-endTime="@Model.EndTime"
                                                                       asp-route-showtimeId="@show.Id"
                                                                       class="min-w-[170px] bg-neutral-900 border border-neutral-700
                                                      rounded-xl p-3 hover:border-primary
                                                      hover:bg-neutral-800 transition-all">
                                                                        <div class="text-xs text-neutral-400">Từ</div>
                                                                        <div class="text-xs text-white font-semibold mb-2">
                                                                            @show.StartTime.ToString("dd/MM/yyyy HH:mm")
                                                                        </div>
                                                                        <div class="text-xs text-neutral-400">Đến</div>
                                                                        <div class="text-xs text-white font-semibold">
                                                                            @show.EndTime.ToString("dd/MM/yyyy HH:mm")
                                                                        </div>
                                                                    </a>
                                                                }
                                                            </div>
                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    <div class="text-sm text-neutral-400 px-2">
                                                        Không có suất chiếu
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </aside>
            <!-- Middle Column: Seat Map -->
            <section class="lg:col-span-6 flex flex-col items-center py-8">

                <!-- Screen -->
                <div class="w-full flex flex-col items-center mb-16 screen-curve">
                    <div class="screen-element mb-4"></div>
                    <p class="text-[10px] tracking-[0.4em] font-bold text-neutral-500 uppercase">
                        Màn Hình / Screen
                    </p>
                </div>

                <div class="flex flex-col gap-3 mb-12">

                    @if (Model.Seats != null && Model.Seats.Any())
                    {
                        var rows = Model.Seats
                        .GroupBy(x => x.RowNumber)
                        .OrderBy(x => x.Key);

                        var maxColumn = Model.Seats.Max(x => x.ColumnNumber);

                        foreach (var row in rows)
                        {
                            var rowLetter = ((char)(64 + row.Key)).ToString();

                            <div class="flex items-center gap-3 justify-center">

                                <span class="text-[10px] w-4 text-neutral-600 text-center">
                                    @rowLetter
                                </span>

                                <div class="grid gap-2"
                                     style="grid-template-columns: repeat(@maxColumn, 2rem);">

                                    @for (int col = 1; col <= maxColumn; col++)
                                    {
                                        var seat = row.FirstOrDefault(x => x.ColumnNumber == col);

                                        if (seat == null)
                                        {
                                            <div class="size-8"></div>
                                            continue;
                                        }

                                        var seatLabel = $"ID{seat.SeatId}";

                                        if (seat.Status == "Booked")
                                        {
                                            <div class="size-8 rounded-lg bg-neutral-700 border border-neutral-600 flex items-center justify-center">
                                                <span class="material-symbols-outlined text-xs text-neutral-500">
                                                    close
                                                </span>
                                            </div>
                                        }
                                        else if (seat.Status == "Pending")
                                        {
                                            <div class="size-8 rounded-lg seat-pending flex items-center justify-center shadow">
                                                <span class="text-black font-bold text-[10px]">
                                                    @seatLabel
                                                </span>
                                            </div>
                                        }
                                        else
                                        {
                                            var vipClass = seat.SeatType == "Vip"
                                            ? "border-2 border-primary/50 bg-primary/10 text-primary"
                                            : "bg-neutral-800 border border-neutral-700";

                                            <div class="seat-item size-8 rounded-lg flex items-center justify-center
                                                            hover:bg-primary/20 transition cursor-pointer
                                                            @vipClass"
                                                 data-seat-id="@seat.Id"
                                                 data-seat-label="@seatLabel"
                                                 data-price="@seat.Price">

                                                <span class="text-[10px]">
                                                    @seatLabel
                                                </span>

                                            </div>
                                        }
                                    }

                                </div>

                                <span class="text-[10px] w-4 text-neutral-600 text-center">
                                    @rowLetter
                                </span>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-neutral-500 text-sm text-center">
                            Hãy chọn suất chiếu để xem sơ đồ ghế
                        </div>
                    }

                </div>

                <!-- Legend -->
                <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6 text-[10px] font-bold uppercase tracking-widest text-neutral-500">

                    <div class="flex items-center gap-2">
                        <div class="size-3 rounded-sm bg-neutral-800 border border-neutral-700"></div>
                        <span>Thường (Còn trống)</span>
                    </div>

                    <div class="flex items-center gap-2">
                        <div class="size-3 rounded-sm border-2 border-primary/50 bg-primary/10"></div>
                        <span class="text-primary">VIP (Còn trống)</span>
                    </div>

                    <div class="flex items-center gap-2">
                        <div class="size-3 rounded-sm bg-neutral-700 flex items-center justify-center">
                            <span class="material-symbols-outlined text-[8px]">close</span>
                        </div>
                        <span>Đã đặt & Thanh toán</span>
                    </div>

                    <div class="flex items-center gap-2">
                        <div class="size-3 rounded-sm seat-pending"></div>
                        <span class="text-accent-cyan">Chờ thanh toán</span>
                    </div>

                    <div class="flex items-center gap-2">
                        <div class="size-3 rounded-sm bg-primary shadow shadow-primary/50"></div>
                        <span class="text-white">Bạn đang chọn</span>
                    </div>

                </div>

            </section>
            <!-- Right Column: Summary -->
            <aside class="lg:col-span-3">

                <div class="bg-neutral-800 rounded-3xl p-6 border border-neutral-700 sticky top-24">

                    <h3 class="text-lg font-bold mb-6 flex items-center gap-2 text-white">
                        <span class="material-symbols-outlined text-primary">confirmation_number</span>
                        Thông tin vé
                    </h3>

                    <div class="space-y-4 mb-8">

                        <div class="flex justify-between items-start">
                            <span class="text-neutral-500 text-sm">Phim</span>
                            <span class="text-right font-medium max-w-[150px] text-white">
                                @Model.Movie?.Title
                            </span>
                        </div>

                        <div class="flex justify-between">
                            <span class="text-neutral-500 text-sm">Suất chiếu</span>
                            <span id="showtimeInfo" class="font-medium text-primary">
                                @(Model.Showtimes?.FirstOrDefault(x => x.Id == Model.ShowtimeId)?.StartTime.ToString("HH:mm, dd/MM"))
                            </span>
                        </div>

                        <div class="flex justify-between">
                            <span class="text-neutral-500 text-sm">Rạp / Phòng</span>
                            <span class="font-medium text-white">
                                @(Model.Showtimes?.FirstOrDefault(x => x.Id == Model.ShowtimeId)?.RoomName)
                            </span>
                        </div>

                        <div class="flex justify-between border-t border-neutral-700 pt-4">
                            <span class="text-neutral-500 text-sm">Ghế đã chọn</span>
                            <span id="selectedSeats" class="font-bold text-accent-cyan">
                                Chưa chọn
                            </span>
                        </div>

                    </div>

                    <div class="bg-neutral-900 rounded-2xl p-4 mb-6">

                        <div class="flex justify-between items-center mb-1">

                            <span class="text-xs text-neutral-500 uppercase font-bold tracking-wider">
                                Tổng cộng
                            </span>

                            <span id="totalPrice" class="text-primary text-xl font-black">
                                0đ
                            </span>

                        </div>

                    </div>

                    <form method="get" id="paymentForm">
                        <input type="hidden" name="Id" value="@Model.Id" />
                        <input type="hidden" name="TheaterId" value="@Model.TheaterId" />
                        <input type="hidden" name="StartTime" value="@Model.StartTime?.ToString("yyyy-MM-dd")" />
                        <input type="hidden" name="EndTime" value="@Model.EndTime?.ToString("yyyy-MM-dd")" />
                        <input type="hidden" name="ShowtimeId" value="@Model.ShowtimeId" />
                        <div id="seatInputs"></div>
                        <button type="submit"
                                class="w-full bg-primary hover:bg-orange-500 text-white font-bold py-4 rounded-full shadow-lg shadow-primary/20 transition-all flex items-center justify-center gap-2 group">
                            Xác nhận & Thanh toán
                            <span class="material-symbols-outlined group-hover:translate-x-1 transition-transform">
                                arrow_forward
                            </span>
                        </button>
                    </form>

                    <p class="text-center text-neutral-500 text-[10px] mt-4 px-4 leading-relaxed">
                        Bằng cách nhấn nút, bạn đồng ý với các Điều khoản & Chính sách của CinemaVN.
                    </p>

                </div>
            </aside>
        </main>
        <footer class="mt-auto border-t border-neutral-800 bg-neutral-900/50 py-8">
            <div class="max-w-[1440px] mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-4">
                <div class="text-neutral-500 text-xs">
                    Thiết kế bởi LocCute.
                </div>
                <div class="flex gap-6 text-neutral-400 text-xs">
                    <a class="hover:text-primary transition-colors" href="#">Quy định giao dịch</a>
                    <a class="hover:text-primary transition-colors" href="#">Chính sách bảo mật</a>
                    <a class="hover:text-primary transition-colors" href="#">Liên hệ</a>
                </div>
            </div>
        </footer>
    </div>
</body>
</html>

<script>
    const selectedSeats = [];
    const seats = document.querySelectorAll(".seat-item");
    const seatDisplay = document.getElementById("selectedSeats");
    const priceDisplay = document.getElementById("totalPrice");
    // div chứa hidden input
    const seatInputs = document.getElementById("seatInputs");
    seats.forEach(seat => {
        seat.addEventListener("click", function () {
            const id = this.dataset.seatId;
            const label = this.dataset.seatLabel;
            const price = parseFloat(this.dataset.price);
            const index = selectedSeats.findIndex(x => x.id == id);
            if (index >= 0) {
                // bỏ chọn ghế
                selectedSeats.splice(index, 1);
                this.classList.remove(
                    "bg-primary",
                    "text-white",
                    "shadow",
                    "shadow-primary/50"
                );
            } else {
                // thêm ghế
                selectedSeats.push({
                    id: id,
                    label: label,
                    price: price
                });
                this.classList.add(
                    "bg-primary",
                    "text-white",
                    "shadow",
                    "shadow-primary/50"
                );
            }
            updateTicket();
        });
    });
    function updateTicket() {
        // reset hidden inputs
        seatInputs.innerHTML = "";
        if (selectedSeats.length === 0) {

            seatDisplay.innerText = "Chưa chọn";
            priceDisplay.innerText = "0đ";

            return;
        }
        const labels = selectedSeats.map(x => x.label);
        const total = selectedSeats
            .map(x => x.price)
            .reduce((a, b) => a + b, 0);
        seatDisplay.innerText = labels.join(", ");
        priceDisplay.innerText = total.toLocaleString("vi-VN") + "đ";
        // tạo hidden inputs cho Razor
        selectedSeats.forEach(seat => {
            const input = document.createElement("input");
            input.type = "hidden";
            input.name = "ShowtimeSeatIds";
            input.value = seat.id;
            seatInputs.appendChild(input);
        });
    }
</script>